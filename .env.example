# ==========================================
# INHYPE PERFUME ATELIER — ENVIRONMENT CONFIG
# ==========================================

# Public site URL for SEO, Open Graph, and canonical links
NEXT_PUBLIC_SITE_URL=https://inhype-atelier.kz

# Official WhatsApp Consultation & Order Number (Format: digits only with country code, e.g. 77001234567)
# Leave empty until confirmed by INHYPE management; the UI will show a clear notice if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Official Instagram profile handle and URL
NEXT_PUBLIC_INSTAGRAM_HANDLE=@inhype_perfume
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/inhype_perfume/

# ==========================================
# SUPABASE INTEGRATION (Database, Auth, Storage)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key for administrative mutations & order registration
# NEVER expose this key with NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of authorized administrator emails for /admin access
ADMIN_ALLOWED_EMAILS=admin@inhype.kz
